{
  "name": "janja",
  "productName": "JanJa",
  "version": "0.1.1",
  "description": "Compartilhamento de tela P2P entre amigos, com o host como servidor da sala. Custo zero.",
  "main": "./out/main/index.js",
  "author": "Pedro Vitor",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:e2e": "tsx --tsconfig tsconfig.node.json tests/e2e/mesh.e2e.mts",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "cloudflared": "^0.7.3",
    "electron-updater": "^6.8.11",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SEU_USUARIO/janja.git"
  }
}
