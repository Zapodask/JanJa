{
  "name": "janja",
  "version": "0.2.0",
  "description": "Compartilhamento de tela P2P entre amigos, direto no navegador. Custo zero.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrohhope/JanJa.git"
  },
  "scripts": {
    "dev": "vite build && concurrently -k -n web,worker -c magenta,cyan \"vite build --watch\" \"wrangler dev\"",
    "build": "npm run typecheck && vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/mesh.e2e.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
